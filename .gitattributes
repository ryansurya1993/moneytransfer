# Normalize line endings: LF in the repo and in the working tree,
# so shell scripts and Dockerfiles work inside Linux containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no line-ending conversion or textual diff.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
