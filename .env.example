# Copy to .env to override the defaults in docker-compose.yml. Local development values only.

POSTGRES_USER=moneytransfer
POSTGRES_PASSWORD=moneytransfer
POSTGRES_DB=moneytransfer
# Host port of Postgres, for a database tool. Not 5432, so it doesn't clash with a local Postgres.
POSTGRES_PORT=15432

# Whole rupiah. Only applied to a fresh database (`docker compose down -v` to reset).
INITIAL_BALANCE=1000000000

# Host port of HAProxy, which spreads requests over the api replicas.
API_PORT=18080

# api (empty or unset means the built-in default shown here)
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
# HAProxy's `timeout server` in deploy/haproxy/haproxy.cfg has the same value; change both.
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
# Postgres ends a session idle inside a transaction for this long, releasing its row locks.
# Must stay above RELAY_PUBLISH_TIMEOUT.
DB_IDLE_IN_TRANSACTION_TIMEOUT=10s
# api: limit for one request's database work, including the wait for a pooled connection (503 when hit).
# worker: limit for each database step; an unreachable database is retried.
DB_TIMEOUT=3s
# Whole rupiah per transfer.
MAX_TRANSFER_AMOUNT=250000000
MERCHANT_ID=1
# debug, info, warn or error
LOG_LEVEL=info

# mockprovider (fake payout provider; calls not covered by the percentages succeed)
MOCK_MIN_DELAY=200ms
MOCK_MAX_DELAY=2s
MOCK_FAILURE_PERCENT=10
# Paid, but the answer stalls for MOCK_HANG_DURATION, longer than the caller waits.
MOCK_TIMEOUT_PERCENT=5
# 503 without paying.
MOCK_UNAVAILABLE_PERCENT=5
MOCK_HANG_DURATION=8s

# rabbitmq
RABBITMQ_USER=moneytransfer
RABBITMQ_PASSWORD=moneytransfer
# Management UI on the host, for watching the queues.
RABBITMQ_UI_PORT=18672

# relay
RELAY_POLL_INTERVAL=200ms
RELAY_BATCH_SIZE=50
# How long to wait for the broker to confirm one message.
RELAY_PUBLISH_TIMEOUT=5s
# /healthz fails when the relay loop has not finished a round for this long.
RELAY_STALL_TIMEOUT=1m
# Unsent outbox events older than this raise an outbox_backlog alert in the log.
OUTBOX_ALERT_AGE=2m
# Failed deliveries before a message moves to the transfers.dlq dead-letter queue.
# Fixed when the queue is created: on an existing broker a new value makes the relay and worker
# fail at startup (PRECONDITION_FAILED) until the queue is deleted or `docker compose down -v`.
QUEUE_DELIVERY_LIMIT=5
# Open transfers (PENDING, PROCESSING, UNKNOWN) unchanged for this long are sent to the worker again.
# The gap doubles after each try, up to an hour: 1m, 2m, 4m ... about 3 hours for 8 tries.
RECONCILE_AFTER=1m
# After this many reconcile tries the transfer waits for a person (reconcile_exhausted alert).
RECONCILE_MAX_ATTEMPTS=8

# worker
# Messages handled at once by one worker process; scale further with `docker compose up --scale worker=3`.
WORKER_CONCURRENCY=20
# How long payouts in progress may finish after SIGTERM. Must exceed one full round of provider retries.
WORKER_SHUTDOWN_TIMEOUT=20s
# One provider call.
PROVIDER_TIMEOUT=3s
# Calls without a definite answer before the transfer becomes UNKNOWN (not refunded).
PROVIDER_MAX_ATTEMPTS=3
# Waits between calls grow from the base up to the max, with random jitter.
PROVIDER_BACKOFF_BASE=1s
PROVIDER_BACKOFF_MAX=4s

# loadtest (`make loadtest`, `make topup`)
LOADTEST_TARGET_URL=http://haproxy:8080
# The mock provider's payouts are compared with each transfer's outcome.
LOADTEST_PROVIDER_URL=http://mockprovider:8080
LOADTEST_RATE=20
LOADTEST_DURATION=30s
# Requests waiting for an answer at once; a request with no free slot is skipped and counted.
LOADTEST_CONCURRENCY=20
# Share of requests that reuse an earlier Idempotency-Key, half as later retries, half sent twice at once.
LOADTEST_DUPLICATE_PERCENT=10
# Share of accounts ending in 0001-0004, which the mock provider answers with a fixed outcome.
LOADTEST_MAGIC_PERCENT=5
LOADTEST_REQUEST_TIMEOUT=5s
# How long to wait for the run's transfers to reach an outcome before the check fails.
LOADTEST_DRAIN_TIMEOUT=90s
LOADTEST_MIN_AMOUNT=50000
LOADTEST_MAX_AMOUNT=5000000
